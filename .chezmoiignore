{{ $brewPath := lookPath "brew" -}}
{{ if eq $brewPath "" -}}
.config/fish/conf.d/brew.fish
{{ end -}}

{{ $orbPath := lookPath "orb" -}}
{{ if eq $orbPath "" -}}
.config/fish/conf.d/orbstack.fish
{{ end -}}

{{ $archBased := eq (includeTemplate "arch-based" .) "true" -}}
{{ if not (and $archBased .desktop) -}}
.chezmoiscripts/archlinux-02-set-xdg-mime-defaults.sh
.config/btop/
.config/foot/
.config/kitty/
.config/noctalia/
.config/umbriel/
.config/xdg-terminals.list
.local/share/applications/fastfetch-kitty.desktop
{{ end -}}

{{ if not $archBased -}}
.chezmoiscripts/archlinux-00-install-packages.sh
{{ end -}}

{{ if ne .osid "darwin" -}}
.chezmoiscripts/darwin-00-install-packages.sh
{{ end -}}

{{ if not .wsl -}}
.config/fish/conf.d/wsl2-ssh-agent.fish
{{ end -}}

{{ if ne .osid "darwin" -}}
.config/tinycast/settings.json
{{ end -}}

