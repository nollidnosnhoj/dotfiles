if test -d $HOME/.dotnet
    if not contains -- $HOME/.dotnet/tools $PATH
        set -p PATH $HOME/.dotnet/tools
    end
end

set -gx ASPIRE_CONTAINER_RUNTIME podman

# Added by get-aspire-cli.sh
fish_add_path $HOME/.aspire/bin

{{ if eq .osid "linux-cachyos" -}}
# Include the ASP.NET development certificate directory on CachyOS.
set -gx SSL_CERT_DIR "$HOME/.aspnet/dev-certs/trust:$SSL_CERT_DIR"
{{ end -}}
