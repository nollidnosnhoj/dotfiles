{{- if and (eq .osid "linux-arch") .desktop -}}
#!/bin/bash
set -euo pipefail

if ! command -v xdg-mime >/dev/null 2>&1; then
    echo "xdg-mime not found; skipping MIME defaults"
    exit 0
fi

xdg-mime default dev.noctalia.luciole.desktop inode/directory
xdg-mime default floorp.desktop text/html
xdg-mime default floorp.desktop x-scheme-handler/http
xdg-mime default floorp.desktop x-scheme-handler/https
xdg-settings set default-web-browser floorp.desktop
{{- end -}}
