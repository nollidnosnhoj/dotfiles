{{- $validOs := list "linux-arch" "linux-cachyos" -}}
{{ if has .osid $validOs -}}
#!/bin/bash
set -euo pipefail

echo "Updating Arch repositories"
sudo pacman -Syu

echo "Installing core packages..."
paru -S --needed {{ .packages.arch.core | join " " }}

{{ if eq .osid "linux-cachyos" -}}
echo "Installing desktop packages..."
paru -S --needed {{ .packages.arch.desktop | join " " }}
{{ end -}}
{{ end -}}
