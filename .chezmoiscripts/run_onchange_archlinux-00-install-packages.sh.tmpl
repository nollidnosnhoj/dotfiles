{{ if eq .osid "linux-arch" -}}
#!/bin/bash
set -euo pipefail

if ! command -v paru >/dev/null 2>&1; then
    echo "paru not found, installing..."
    sudo pacman -S --needed base-devel
    git clone https://aur.archlinux.org/paru.git
    pushd paru
    makepkg -si
    popd
    rm -rf paru
fi

packages=(
    {{ .packages.arch.core | join " " }}
{{ if and (eq .osid "linux-arch") (eq .hosttype "desktop") -}}
    {{ .packages.arch.desktop | join " " }}
{{ end -}}
)

# Match update's policy: check upstream Git commits, not just AUR versions.
echo "Updating Arch Linux and AUR packages and installing configured packages..."
paru -Syu --devel --needed "${packages[@]}"
{{ end -}}
