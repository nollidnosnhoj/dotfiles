#!/bin/bash

if ! command -v chezmoi &> /dev/null; then
    echo "chezmoi not found"
    exit 1
fi

chezmoi add \
    ~/.config/btop/themes/noctalia.theme \
    ~/.config/foot/themes/noctalia/ \
    ~/.config/gtk-3.0/noctalia.css \
    ~/.config/gtk-4.0/noctalia.css \
    ~/.config/ghostty/themes/noctalia \
    ~/.config/kitty/themes/noctalia.conf \
    ~/.config/niri/noctalia.kdl \
    ~/.config/qt5ct/colors/noctalia.conf \
    ~/.config/qt6ct/colors/noctalia.conf \
    ~/.config/opencode/themes/matugen.json \
    ~/.pi/agent/themes/noctalia.json \
    ~/.config/zed/themes/noctalia.json \
    ~/.config/bat/themes/noctalia.tmTheme \
    ~/.config/lazygit/ \
    ~/.config/yazi/theme.toml \
    ~/.config/yazi/flavors/noctalia.yazi/flavor.toml \
    ~/.config/yazi/flavors/noctalia.yazi/tmtheme.xml \
    ~/.config/starship.toml
