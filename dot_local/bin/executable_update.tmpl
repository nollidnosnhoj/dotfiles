#!/usr/bin/env bash
{{- $hasParu := lookPath "paru" -}}
{{- $hasBrew := lookPath "brew" -}}
{{- $hasMise := lookPath "mise" -}}
{{- $hasShelly := lookPath "shelly" -}}

{{ if $hasBrew }}
echo "Updating Homebrew packages..."
brew update
brew upgrade
echo "Updating Homebrew casks..."
brew upgrade --cask --greedy
{{ end }}
{{ if $hasParu }}
echo "Updating Arch Linux and AUR packages (including Git packages)..."
paru -Syu --devel
{{ else if $hasShelly }}
echo "Updating system packages with shelly..."
shelly
{{ end }}
{{ if $hasMise }}
echo "Updating mise..."
mise self-update
echo "Updating mise tools..."
mise upgrade
{{ end }}
